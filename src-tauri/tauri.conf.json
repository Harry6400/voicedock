{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceDock",
  "version": "0.1.1",
  "identifier": "com.harry6400.voicedock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoiceDock",
        "width": 500,
        "height": 690,
        "minWidth": 420,
        "minHeight": 580,
        "decorations": false,
        "resizable": false,
        "visible": true,
        "center": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "菜单栏 AI 配音工作台",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
